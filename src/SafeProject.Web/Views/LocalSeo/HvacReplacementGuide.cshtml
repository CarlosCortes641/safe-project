@{
    ViewData["Title"] = Lang.T(
        "HVAC Replacement in Charlotte, NC (Guide) | Safe Project Solution",
        "Reemplazo HVAC en Charlotte, NC (Guía) | Safe Project Solution");
    ViewData["MetaDescription"] = Lang.T(
        "How HVAC replacement works with Safe in Charlotte: tonnage questions, published starting prices, scope confirmation, and payment path choices.",
        "Cómo funciona el reemplazo HVAC con Safe en Charlotte: preguntas de tonelaje, precios iniciales publicados, confirmación de alcance y rutas de pago.");
    ViewData["OgType"] = "article";
}
<main id="main-content" class="seoPage pad">
    <p class="seoEyebrow">@Lang.T("GUIDE", "GUÍA") · HVAC · CHARLOTTE</p>
    <h1>@Lang.T("HVAC replacement in Charlotte, NC", "Reemplazo HVAC en Charlotte, NC")</h1>
    <p class="lead">@Lang.T("A clear path from starting price to scheduled install — without hiding ductwork exclusions.", "Una ruta clara desde el precio inicial hasta la instalación — sin ocultar exclusiones de ductwork.")</p>

    <div class="seoProse">
        <h2>@Lang.T("Step 1 — Answer three questions", "Paso 1 — Responde tres preguntas")</h2>
        <p>@Lang.T("Tonnage band and need drive the published starting installed price on the home page HVAC tool.", "La banda de tonelaje y la necesidad impulsan el precio instalado inicial publicado en la herramienta HVAC.")</p>
        <h2>@Lang.T("Step 2 — Confirm scope", "Paso 2 — Confirma alcance")</h2>
        <p>@Lang.T("Safe confirms site conditions and discloses non-standard work before authorization.", "Safe confirma condiciones del sitio y divulga trabajo no estándar antes de autorizar.")</p>
        <h2>@Lang.T("Step 3 — Choose payment", "Paso 3 — Elige pago")</h2>
        <p>@Lang.T("Cash, Synchrony, or Safe 24 eligibility review. This website remains a sandbox for live payments.", "Pago completo, Synchrony o revisión Safe 24. Este sitio sigue siendo sandbox para pagos reales.")</p>
    </div>

    <div class="buttons">
        <a class="primary" href="/#hvac">@Lang.T("Start HVAC quote", "Empezar cotización HVAC") →</a>
        <a class="outline" href="/hvac-installation-charlotte">@Lang.T("HVAC service page", "Página de servicio HVAC") →</a>
    </div>
</main>
