    </div>

    <div class="buttons">
        <a class="primary" href="/water-heaters#builder">@Lang.T("See tankless prices", "Ver precios tankless") →</a>
        <a class="outline" href="/guides/water-heater-cost-charlotte">@Lang.T("Cost guide", "Guía de costos") →</a>
    </div>
</main>
