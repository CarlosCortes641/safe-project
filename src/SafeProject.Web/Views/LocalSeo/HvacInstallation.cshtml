@{
    ViewData["Title"] = Lang.T(
        "HVAC Installation Charlotte, NC | Safe Project Solution",
        "Instalación HVAC Charlotte, NC | Safe Project Solution");
    ViewData["MetaDescription"] = Lang.T(
        "HVAC installation and replacement in Charlotte, NC with published starting prices by tonnage. Answer three questions, confirm scope, then choose cash, Synchrony, or Safe 24.",
        "Instalación y reemplazo HVAC en Charlotte, NC con precios iniciales publicados por tonelaje. Responde tres preguntas, confirma alcance y elige pago completo, Synchrony o Safe 24.");
}
<main id="main-content" class="seoPage pad">
    <p class="seoEyebrow">HVAC · CHARLOTTE, NC</p>
    <h1>@Lang.T("HVAC installation in Charlotte, NC", "Instalación HVAC en Charlotte, NC")</h1>
    <p class="lead">@Lang.T("Safe Project Solution replaces cooling and heating systems with standard labor and published starting prices. Ductwork is not included in the published bands.", "Safe Project Solution reemplaza sistemas de enfriamiento y calefacción con labor estándar y precios iniciales publicados. El ductwork no está incluido en las bandas publicadas.")</p>

    <div class="seoProse">
        <h2>@Lang.T("Published starting path", "Ruta de precio publicada")</h2>
        <p>@Lang.T("Use the three-question HVAC tool on the home page to see a starting installed price by tonnage and need, then confirm site conditions before authorization.", "Usa la herramienta HVAC de tres preguntas en la página principal para ver un precio instalado inicial por tonelaje y necesidad; luego confirma condiciones del sitio antes de autorizar.")</p>
        <h2>@Lang.T("Warranty snapshot", "Resumen de garantía")</h2>
        <ul>
            <li>@Lang.T("1-year Safe labor on covered HVAC replacement", "1 año de labor Safe en reemplazo HVAC cubierto")</li>
            <li>@Lang.T("5-year manufacturer warranty on covered equipment", "5 años de garantía del fabricante en equipo cubierto")</li>
        </ul>
        <h2>@Lang.T("Related pages", "Páginas relacionadas")</h2>
        <p class="seoCityLinks">
            <a href="/#hvac">@Lang.T("HVAC quick quote", "Cotización rápida HVAC")</a>
            <a href="/water-heaters">Water heaters</a>
            <a href="/guides/hvac-replacement-charlotte">@Lang.T("Replacement guide", "Guía de reemplazo")</a>
            <a href="/faq">FAQ</a>
        </p>
    </div>

    <div class="buttons">
        <a class="primary" href="/#hvac">@Lang.T("See HVAC starting price", "Ver precio inicial HVAC") →</a>
        <a class="outline" href="tel:@CatalogStore.PhoneTel">@Lang.T("Call", "Llamar") @CatalogStore.PhoneDisplay</a>
    </div>
</main>
