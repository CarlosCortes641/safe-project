@model HomeViewModel
<main id="main-content">
    @await Html.PartialAsync("_SandboxBanner")
    <section class="hero">
        <div>
            <p>HVAC · WATER HEATERS · CHARLOTTE</p>
            <h1>@Lang.T("HVAC & Water Heater Installation in Charlotte, NC", "Instalación de HVAC y Water Heaters en Charlotte, NC")</h1>
            <p class="lead">@Lang.T("Safe Project Solution provides HVAC and water heater installation, replacement, maintenance, and repair services in Charlotte, North Carolina and surrounding areas.", "Safe Project Solution ofrece instalación, reemplazo, mantenimiento y reparación de HVAC y water heaters en Charlotte, North Carolina y áreas aledañas.")</p>
            <div class="choice">
                <a href="#hvac"><b>❄</b><span>@Lang.T("Air conditioning", "Aire acondicionado")<small>@Lang.T("Start HVAC questions", "Comenzar preguntas HVAC") →</small></span></a>
                <a href="/water-heaters"><b>♨</b><span>Water heaters<small>@Lang.T("See installed prices", "Ver precios instalados") →</small></span></a>
            </div>
            <div class="checks">
                <span>✓ @Lang.T("Licensed general contractor", "General contractor con licencias")</span>
                <span>✓ @Lang.T("Up to 30 years of technician experience", "Técnicos con hasta 30 años de experiencia")</span>
                <span>✓ English / Español</span>
            </div>
        </div>
        <aside>
            <em>SAFE HVAC SOLUTION LLC</em>
            <div>@Lang.T("Two essential systems", "Dos sistemas esenciales")</div>
            <strong>@Lang.T("One team", "Un equipo")</strong>
            <span>@Lang.T("Quote · finance · schedule", "Cotizar · financiar · agendar")</span>
        </aside>
    </section>

    <div class="proof">
        <span>@Lang.T("Built around clarity", "Hecho para la claridad")</span>
        <span><b>1</b> @Lang.T("See price", "Ver precio") · <b>2</b> @Lang.T("Confirm scope", "Confirmar alcance") · <b>3</b> @Lang.T("Choose payment", "Elegir pago") · <b>4</b> @Lang.T("Book install", "Agendar instalación")</span>
    </div>

    <section class="specialties pad" id="solutions">
        <div class="heading">
            <p>@Lang.T("WHAT SAFE SPECIALIZES IN", "EN QUÉ SE ESPECIALIZA SAFE")</p>
            <h2>@Lang.T("HVAC and water heating first.", "HVAC y water heaters primero.")</h2>
            <div>@Lang.T("Safe is a licensed general contracting company with construction capabilities. Our primary sales focus is the essential mechanical systems homeowners need most.", "Safe es un general contractor con licencia y capacidades de construcción. El foco comercial principal son los sistemas mecánicos esenciales.")</div>
        </div>
        <div class="specialtyGrid">
            <article>
                <b>❄</b>
                <h3>@Lang.T("Air conditioning & heating", "Aire acondicionado y calefacción")</h3>
                <p>@Lang.T("Sales, installation, replacement, maintenance, system evaluation, warranty verification, and transparent project scope.", "Venta, instalación, reemplazo, mantenimiento, evaluación, verificación de garantía y alcance transparente.")</p>
                <a href="#hvac">@Lang.T("Start HVAC quote", "Empezar cotización HVAC") →</a>
            </article>
            <article>
                <b>♨</b>
                <h3>Water heaters</h3>
                <p>@Lang.T("Tank and tankless sales, installation, replacement, maintenance, installed pricing, and flexible payment paths.", "Venta e instalación de tanque y tankless, precios instalados y rutas de pago claras.")</p>
                <a href="/water-heaters">@Lang.T("Build my price", "Armar mi precio") →</a>
            </article>
            <article>
                <b>✓</b>
                <h3>@Lang.T("Licensed project support", "Apoyo de proyectos con licencia")</h3>
                <p>@Lang.T("Mechanical and structural risk evaluation, warranty records, repair planning, and closing support for Realtors and investors.", "Evaluación de riesgo, registros de garantía, plan de reparación y apoyo de cierre para Realtors e inversionistas.")</p>
                <a href="#property">@Lang.T("See specialist support", "Ver apoyo especializado") →</a>
            </article>
        </div>
    </section>

    <section class="finder pad" id="compare">
        <div class="heading">
            <p>@Lang.T("WATER HEATER LANDING", "LANDING DE WATER HEATERS")</p>
            <h2>@Lang.T("Compare electric, gas, and tankless with published installed prices.", "Compara eléctrico, gas y tankless con precios instalados publicados.")</h2>
            <div>@Lang.T("Water heater matching and the online price builder now live on their own page so customers and search engines can find them directly.", "La coincidencia de water heaters y la calculadora de precio viven en su propia página para clientes y buscadores.")</div>
        </div>
        <div class="finderGrid">
            <article>
                <span>⚡</span>
                <h3>@Lang.T("Electric tank", "Tanque eléctrico")</h3>
                <p>@Lang.T("40-, 50-, or 60-gallon replacements with published Charlotte installed pricing.", "Reemplazos de 40, 50 o 60 galones con precios instalados publicados en Charlotte.")</p>
                <a href="/water-heaters#compare">@Lang.T("Open water heater page", "Abrir página de water heaters") →</a>
            </article>
            <article>
                <span>🔥</span>
                <h3>@Lang.T("Gas tank", "Tanque de gas")</h3>
                <p>@Lang.T("Same-fuel replacements when location and connections stay standard.", "Reemplazos del mismo combustible cuando ubicación y conexiones siguen estándar.")</p>
                <a href="/water-heaters#compare">@Lang.T("Open water heater page", "Abrir página de water heaters") →</a>
            </article>
            <article>
                <span>∞</span>
                <h3>Tankless</h3>
                <p>@Lang.T("Continuous hot water paths with verification for gas, electrical, venting, and access.", "Rutas de agua caliente continua con verificación de gas, electricidad, ventilación y acceso.")</p>
                <a href="/water-heaters#builder">@Lang.T("See tankless prices", "Ver precios tankless") →</a>
            </article>
            <article>
                <span>❄</span>
                <h3>@Lang.T("Complete HVAC", "HVAC completo")</h3>
                <p>@Lang.T("You need AC plus heating equipment replacement, repair diagnosis, maintenance, or a mechanical risk assessment.", "Necesitas reemplazo de AC y calefacción, diagnóstico, mantenimiento o evaluación de riesgo.")</p>
                <a href="#hvac">@Lang.T("Answer 3 HVAC questions", "Responder 3 preguntas HVAC") →</a>
            </article>
        </div>
        <div class="buttons centered" style="margin-top:1.5rem">
            <a class="primary" href="/water-heaters">@Lang.T("Go to water heater installation page", "Ir a la página de instalación de water heaters") →</a>
        </div>
    </section>

    <section class="hvac" id="hvac">
        <div>
            <p>SAFE HVAC DIRECT · @Lang.T("QUICK QUOTE", "COTIZACIÓN RÁPIDA")</p>
            <h2>@Lang.T("Answer three questions. See your starting price.", "Responde tres preguntas. Ve tu precio inicial.")</h2>
            <div class="hvacQuestions">
                <label>@Lang.T("What do you need?", "¿Qué necesitas?")
                    <select id="hvac-need">
                        <option value="replace">@Lang.T("Replace complete AC + heat", "Reemplazar AC + calefacción")</option>
                        <option value="repair">@Lang.T("Repair / diagnosis", "Reparación / diagnóstico")</option>
                        <option value="maintenance">@Lang.T("Maintenance", "Mantenimiento")</option>
                        <option value="risk">@Lang.T("Property risk assessment", "Evaluación de riesgo")</option>
                    </select>
                </label>
                <label>@Lang.T("System size", "Tamaño del sistema")
                    <select id="hvac-tons">
                        <option value="hvac-replace-up-to-2-5" data-price="8000">@Lang.T("Up to 2.5 tons", "Hasta 2.5 toneladas")</option>
                        <option value="hvac-replace-3-4" data-price="10000">@Lang.T("3–4 tons", "3–4 toneladas")</option>
                        <option value="quote" data-price="0">@Lang.T("Not sure", "No estoy seguro")</option>
                    </select>
                </label>
                <label>@Lang.T("Approximate system age", "Edad aproximada")
                    <select>
                        <option>@Lang.T("Not sure", "No estoy seguro")</option>
                        <option>0–9</option>
                        <option>10–14</option>
                        <option>15+</option>
                    </select>
                </label>
            </div>
            <p class="scopeNote">@Lang.T("Safe confirms sizing, electrical, refrigerant lines, access, warranty status, and any non-standard transitions before authorization.", "Safe confirma dimensionamiento, electricidad, líneas, acceso y garantía antes de autorizar.")</p>
        </div>
        <div class="hvacResult">
            <small data-hvac-label>@Lang.T("Complete replacement", "Reemplazo completo")</small>
            <strong data-hvac-price>$8,000</strong>
            <span>✓ @Lang.T("1-year Safe labor warranty", "1 año de garantía de mano de obra Safe")</span>
            <span>✓ @Lang.T("5-year manufacturer warranty", "5 años de garantía del fabricante")</span>
            <span>✓ @Lang.T("Ductwork not included", "Ductwork no incluido")</span>
            <form method="post" asp-controller="Project" asp-action="Start" data-hvac-form style="margin-top:20px">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Kind" value="hvac" />
                <input type="hidden" name="ProductId" value="hvac-replace-up-to-2-5" data-hvac-product />
                <input type="hidden" name="Zip" value="28202" />
                <input type="hidden" name="PaymentPath" value="CashSandbox" />
                <button class="primary" type="submit" data-hvac-submit>@Lang.T("Continue HVAC selection →", "Continuar selección HVAC →")</button>
            </form>
        </div>
    </section>

    <section class="memberships pad" id="plans">
        <div class="heading">
            <p>@Lang.T("PAYMENT CHOICE", "ELECCIÓN DE PAGO")</p>
            <h2>@Lang.T("Apply first. Keep a second path ready.", "Solicita primero. Mantén una segunda ruta lista.")</h2>
        </div>
        <div class="cards">
            <article>
                <b>01</b>
                <h3>Synchrony · @Lang.T("possible $0 down", "posible $0 inicial")</h3>
                <p>@Lang.T("Production will use the official merchant page. This demo never opens live Synchrony and never collects SSN or card data.", "Producción usará la página oficial del comercio. Esta demo no abre Synchrony real y no captura SSN ni tarjeta.")</p>
                <a class="primary cardCta" href="/water-heaters#builder">@Lang.T("Use Synchrony sandbox path →", "Usar ruta sandbox Synchrony →")</a>
            </article>
            <article>
                <b>02</b>
                <h3>Safe 24 · $100 @Lang.T("down", "inicial")</h3>
                <p>@Lang.T("A guided company eligibility review with verified scope, a 24-payment illustration, required disclosures, and signature only after the customer reviews the total.", "Revisión de elegibilidad de la compañía con alcance verificado, ilustración a 24 pagos y firma solo después de revisar el total.")</p>
                <a class="outline cardCta" href="/water-heaters#builder">@Lang.T("See Safe 24 sandbox illustration →", "Ver ilustración sandbox Safe 24 →")</a>
            </article>
            <article>
                <b>03</b>
                <h3>@Lang.T("Cash installed price", "Precio de contado instalado")</h3>
                <p>@Lang.T("Review the published standard scope, confirm site conditions, and continue to a future certified hosted checkout.", "Revisa el alcance estándar publicado, confirma condiciones del sitio y continúa a un checkout alojado futuro.")</p>
                <a class="dark cardCta" href="/water-heaters#builder">@Lang.T("Preview direct checkout →", "Ver checkout directo →")</a>
            </article>
        </div>
    </section>

    <section class="property pad" id="property">
        <p>@Lang.T("TRANSACTION & INVESTMENT SPECIALISTS", "ESPECIALISTAS EN TRANSACCIONES E INVERSIÓN")</p>
        <h2>@Lang.T("Safe Project Solution: technical support from inspection to closing.", "Safe Project Solution: apoyo técnico desde la inspección hasta el cierre.")</h2>
        <div>@Lang.T("Realtors, sellers, first-time buyers, investors, and bank-related projects get trade review, documented scope, and closing coordination.", "Realtors, vendedores, primeros compradores, inversionistas y proyectos de banco reciben revisión técnica, alcance documentado y coordinación de cierre.")</div>
        <div class="realtorGrid">
            <article><b>01</b><h3>@Lang.T("Mechanical risk assessment", "Evaluación de riesgo mecánico")</h3><p>@Lang.T("HVAC and water-heater condition, age, service needs, and replacement exposure.", "Condición, edad, servicio y exposición a reemplazo.")</p></article>
            <article><b>02</b><h3>@Lang.T("Warranty verification", "Verificación de garantía")</h3><p>@Lang.T("Manufacturer registration, coverage status, expiration, serial numbers, and available options.", "Registro, cobertura, vencimiento, seriales y opciones.")</p></article>
            <article><b>03</b><h3>@Lang.T("Structural & moisture awareness", "Riesgo estructural y humedad")</h3><p>@Lang.T("Crawlspace, framing, floors, insulation, moisture, and approximate repair scope.", "Crawlspace, estructura, pisos, aislamiento, humedad y alcance aproximado.")</p></article>
            <article><b>04</b><h3>@Lang.T("Planning & execution", "Planificación y ejecución")</h3><p>@Lang.T("Budgeting, responsive repairs, documentation, construction scope, and closing preparation.", "Presupuesto, reparaciones, documentación, alcance y preparación de cierre.")</p></article>
        </div>
        <div class="realtorBooking">
            <small>PROPERTY DEAL DESK</small>
            <h3>@Lang.T("Send a Realtor / closing request", "Enviar solicitud Realtor / cierre")</h3>
            <p>@Lang.T("Capture transaction stage, technical need, funding review, and a test file name. Payment at closing stays an evaluation only.", "Captura etapa, necesidad técnica, revisión de pago y un archivo de prueba. El pago al cierre sigue siendo solo una evaluación.")</p>
            <div class="dateGrid">
                @foreach (var day in Model.ScheduleDays)
                {
                    var label = day.Date.ToString("ddd, MMM d");
                    if (day.IsFull)
                    {
                        <button type="button" disabled>@label <span>@Lang.T("Full", "Lleno")</span></button>
                    }
                    else
                    {
                        <button type="button" disabled>@label <span>@Lang.T("Open", "Abierto")</span></button>
                    }
                }
            </div>
            <p class="builder-note">@Lang.T($"Test capacity: {Model.CapacityPerDay} install units/day. Full days stay blocked.", $"Capacidad de prueba: {Model.CapacityPerDay} unidades/día. Los días llenos quedan bloqueados.")</p>
            <a class="primary bookRequest" href="/realtor">@Lang.T("Open Realtor request →", "Abrir solicitud Realtor →")</a>
        </div>
    </section>

    <section class="facts pad" id="facts">
        <div class="heading">
            <p>@Lang.T("VERIFIED SERVICE FACTS", "HECHOS VERIFICADOS DEL SERVICIO")</p>
            <h2>@Lang.T("Clear facts for customers, search engines, and AI agents.", "Hechos claros para clientes, buscadores y agentes de IA.")</h2>
        </div>
        <div class="factsGrid">
            <article><b>@Lang.T("Identity", "Identidad")</b><p>Safe Project Solution by Safe HVAC Solution LLC. Powered by Home Indor Technology Inc.</p></article>
            <article><b>@Lang.T("Area", "Área")</b><p>@Lang.T("Charlotte, North Carolina and communities approximately one hour away.", "Charlotte, North Carolina y comunidades a aproximadamente una hora.")</p></article>
            <article><b>Water heater</b><p>@Lang.T("New equipment, expansion tank when applicable, removal, standard connections, 2-year Safe labor, 5-year manufacturer warranty.", "Equipo nuevo, tanque de expansión cuando aplique, retiro, conexiones estándar, 2 años Safe y 5 años de fabricante.")</p></article>
            <article><b>HVAC</b><p>@Lang.T("Cooling and heating replacement with standard labor. Ductwork is not included. 1-year Safe labor, 5-year manufacturer warranty.", "Reemplazo de enfriamiento y calefacción. Ductwork no incluido. 1 año Safe y 5 años de fabricante.")</p></article>
        </div>
        @await Html.PartialAsync("_JsonLd")
    </section>

    <section class="faq pad" id="faq">
        <div class="heading">
            <p>@Lang.T("STRAIGHT ANSWERS", "RESPUESTAS DIRECTAS")</p>
            <h2>@Lang.T("Before you choose.", "Antes de elegir.")</h2>
        </div>
        <details open><summary>@Lang.T("Is the displayed price final?", "¿El precio mostrado es final?")</summary><p>@Lang.T("It covers the published standard scope. Safe confirms site conditions and discloses non-standard work before authorization.", "Cubre el alcance estándar publicado. Safe confirma condiciones del sitio y divulga trabajo no estándar antes de autorizar.")</p></details>
        <details><summary>@Lang.T("Is $0 down with Synchrony guaranteed?", "¿$0 inicial con Synchrony está garantizado?")</summary><p>@Lang.T("No. It may be available for approved applicants. Synchrony determines the promotion, APR, term, and payment.", "No. Puede estar disponible para solicitantes aprobados. Synchrony determina promoción, APR, plazo y pago.")</p></details>
        <details><summary>@Lang.T("Is Safe 24 the same as Synchrony?", "¿Safe 24 es lo mismo que Synchrony?")</summary><p>@Lang.T("No. Safe 24 is the company eligibility path with a $100 initial payment; Synchrony is a separate third-party credit application.", "No. Safe 24 es la ruta de elegibilidad de la compañía con $100 inicial; Synchrony es una solicitud de crédito de terceros.")</p></details>
        <details><summary>@Lang.T("Does this reserve an appointment?", "¿Esto reserva una cita?")</summary><p>@Lang.T("No. Safe first confirms scope, price, and availability.", "No. Safe primero confirma alcance, precio y disponibilidad.")</p></details>
    </section>

    @await Html.PartialAsync("_ContactCtas")

    @{
        ViewData["ClosingTitle"] = Lang.T("Comfort now.", "Confort ahora.");
        ViewData["ClosingBody"] = Lang.T("A payment path that fits.", "Una ruta de pago que encaja.");
        ViewData["ClosingPrimary"] = Lang.T("Price HVAC", "Cotizar HVAC");
        ViewData["ClosingPrimaryHref"] = "#hvac";
        ViewData["ClosingSecondary"] = Lang.T("Price a water heater", "Cotizar water heater");
        ViewData["ClosingSecondaryHref"] = "/water-heaters";
        ViewData["ClosingMicro"] = Lang.T("Charlotte + 1-hour radius. Published scope before you schedule.", "Charlotte + 1 hora alrededor. Alcance publicado antes de agendar.");
    }
    @await Html.PartialAsync("_SiteClosing")
</main>
