@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    ViewData["Robots"] = "noindex, nofollow";
}
<section class="pad">
    <h1>Error</h1>
    <p>@Lang.T("An error occurred while processing your request.", "Ocurrió un error al procesar la solicitud.")</p>
    @if (Model?.ShowRequestId == true)
    {
        <p><code>@Model.RequestId</code></p>
    }
</section>
