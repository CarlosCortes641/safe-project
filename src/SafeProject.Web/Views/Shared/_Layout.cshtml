@{
    var title = ViewData["Title"] as string ?? Lang.T(
        "HVAC & Water Heater Installation Charlotte | Safe Project Solution",
        "Instalación HVAC y Water Heaters Charlotte | Safe Project Solution");
    var description = ViewData["MetaDescription"] as string ?? Lang.T(
        "Published installed prices for water heaters and HVAC replacement in Charlotte. Compare cash, Synchrony and Safe 24.",
        "Precios instalados de water heaters y reemplazo HVAC en Charlotte. Compara pago completo, Synchrony y Safe 24.");
    var robots = ViewData["Robots"] as string ?? "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
    var ogType = ViewData["OgType"] as string ?? "website";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var baseUrl = PublicUrl.Base(Context.Request);
    var path = string.IsNullOrEmpty(Context.Request.Path.Value) ? "/" : Context.Request.Path.Value!;
    var canonical = path == "/" ? baseUrl + "/" : baseUrl + path;
    var enUrl = path == "/" ? baseUrl + "/?lang=en" : baseUrl + path + "?lang=en";
    var esUrl = path == "/" ? baseUrl + "/?lang=es" : baseUrl + path + "?lang=es";
    var ogImage = baseUrl + "/img/og-default.png";
    var locale = Lang.IsSpanish ? "es_US" : "en_US";
    var localeAlt = Lang.IsSpanish ? "en_US" : "es_US";
}
<!DOCTYPE html>
<html lang="@Lang.HtmlLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    <meta name="description" content="@description" />
    <meta name="robots" content="@robots" />
    <meta name="author" content="Safe HVAC Solution LLC" />
    <meta name="geo.region" content="US-NC" />
    <meta name="geo.placename" content="Charlotte" />
    <meta name="geo.position" content="35.2271;-80.8431" />
    <meta name="ICBM" content="35.2271, -80.8431" />
    <link rel="canonical" href="@canonical" />
    <link rel="alternate" hreflang="en" href="@enUrl" />
    <link rel="alternate" hreflang="es" href="@esUrl" />
    <link rel="alternate" hreflang="x-default" href="@enUrl" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="@baseUrl/sitemap.xml" />
    <meta property="og:type" content="@ogType" />
    <meta property="og:site_name" content="Safe Project Solution" />
    <meta property="og:locale" content="@locale" />
    <meta property="og:locale:alternate" content="@localeAlt" />
    <meta property="og:title" content="@title" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Safe Project Solution — HVAC & Water Heaters in Charlotte, NC" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@title" />
    <meta name="twitter:description" content="@description" />
    <meta name="twitter:image" content="@ogImage" />
    <meta name="theme-color" content="#0c4774" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip" href="/#check">@Lang.T("Skip to contact options", "Ir a opciones de contacto")</a>
    <div class="top">
        <span>@Lang.T("CHARLOTTE-ROOTED · HOMEOWNERS · REALTORS · INVESTORS", "CON RAÍCES EN CHARLOTTE · PROPIETARIOS · REALTORS · INVERSIONISTAS")</span>
        <span>@Lang.T("Charlotte + 1-hour radius", "Charlotte + 1 hora alrededor")</span>
    </div>
    <header>
        <a class="brand" href="/">
            <b>SAFE</b>
            <i>PROJECT SOLUTION<small>BY SAFE HVAC SOLUTION LLC · POWERED BY HOME INDOR TECHNOLOGY INC.</small></i>
        </a>
        <nav>
            <a href="/#check">@Lang.T("Start here", "Empieza aquí")</a>
            <a href="/water-heaters">Water heaters</a>
            <a href="/#hvac">HVAC</a>
            <a href="/realtor">Realtors</a>
            <a href="/#plans">@Lang.T("Payment", "Pago")</a>
            <a href="/ops">@Lang.T("Ops", "Ops")</a>
        </nav>
        <a class="lang" href="@(path == "/" ? "/?lang=" : path + "?lang=")@Lang.OtherCode" aria-label="@Lang.T("Switch to Spanish", "Cambiar a inglés")">@Lang.ToggleLabel</a>
        <div class="headerContact">
            <a href="sms:@CatalogStore.TextTel">@Lang.T("Text", "Texto") @CatalogStore.TextShort</a>
            <i aria-hidden="true">•</i>
            <a href="tel:@CatalogStore.PhoneTel">@Lang.T("Call", "Llamar") @CatalogStore.PhonePlain</a>
        </div>
    </header>
    @RenderBody()
    <div class="mobileContactBar" aria-label="@Lang.T("Contact options", "Opciones de contacto")">
        <a class="mobileContactBar-text" href="sms:@CatalogStore.TextTel">@Lang.T("Text", "Texto")</a>
        <a class="mobileContactBar-call" href="tel:@CatalogStore.PhoneTel">@Lang.T("Call", "Llamar")</a>
    </div>
    <footer>
        <div class="footerTop">
            <div class="footerBrand">
                <strong>Safe Project Solution</strong>
                <p>@Lang.T("Published installed prices for HVAC and water heaters in Charlotte — cash, Synchrony, and Safe 24 paths.", "Precios instalados de HVAC y water heaters en Charlotte — rutas de pago completo, Synchrony y Safe 24.")</p>
                <a class="footerEmail" href="mailto:@CatalogStore.Email">@CatalogStore.Email</a>
            </div>
            <div class="footerLinks">
                <div>
                    <p>@Lang.T("Explore", "Explorar")</p>
                    <a href="/#check">@Lang.T("Start here", "Empieza aquí")</a>
                    <a href="/water-heaters">Water heaters</a>
                    <a href="/hvac-installation-charlotte">HVAC</a>
                    <a href="/tankless-water-heater-charlotte">Tankless</a>
                    <a href="/#plans">@Lang.T("Payment", "Pago")</a>
                    <a href="/realtor">Realtors</a>
                    <a href="/faq">FAQ</a>
                    <a href="/about">@Lang.T("About", "Nosotros")</a>
                </div>
                <div>
                    <p>@Lang.T("Contact", "Contacto")</p>
                    <a href="sms:@CatalogStore.TextTel">@Lang.T("Text", "Texto") @CatalogStore.TextShort</a>
                    <a href="tel:@CatalogStore.PhoneTel">@Lang.T("Call", "Llamar") @CatalogStore.PhonePlain</a>
                    <a href="mailto:@CatalogStore.Email">Email</a>
                </div>
                <div>
                    <p>@Lang.T("Areas & guides", "Áreas y guías")</p>
                    @foreach (var city in SafeProject.Web.Infrastructure.SeoContent.Cities.Take(4))
                    {
                        <a href="/areas/@city.Slug">@Lang.T(city.NameEn, city.NameEs)</a>
                    }
                    <a href="/guides/water-heater-cost-charlotte">@Lang.T("WH cost guide", "Guía costo WH")</a>
                    <a href="/guides/hvac-replacement-charlotte">@Lang.T("HVAC guide", "Guía HVAC")</a>
                    <a href="/sitemap.xml">sitemap.xml</a>
                    <a href="/llms.txt">llms.txt</a>
                </div>
            </div>
        </div>
        <div class="footerBottom">
            <span>© @DateTime.UtcNow.Year Safe HVAC Solution LLC · Home Indor Technology Inc.</span>
            <span>@Lang.T("Sandbox website. No live payments, no live Safe 24, no payment-at-closing.", "Website sandbox. Sin pagos reales, sin Safe 24 productivo, sin pago al cierre.")</span>
        </div>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
