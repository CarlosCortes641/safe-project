<section class="scope pad" id="scope">
    <div class="heading">
        <p>@Lang.T("FAST SCOPE CHECK", "CONFIRMACIÓN RÁPIDA DEL ALCANCE")</p>
        <h2>@Lang.T("Help us confirm the right install.", "Ayúdanos a confirmar la instalación correcta.")</h2>
        <div>@Lang.T("These details reduce surprises. They do not place an order or submit a credit application.", "Estos datos reducen sorpresas. No crean una orden ni envían una solicitud de crédito.")</div>
    </div>
    <div class="scopegrid">
        <article>
            <b>01</b>
            <h3>@Lang.T("How urgent is it?", "¿Qué tan urgente es?")</h3>
            <button type="button" class="on">@Lang.T("Leaking / no hot water", "Fuga / sin agua caliente")</button>
            <button type="button">@Lang.T("Replace soon", "Reemplazar pronto")</button>
            <button type="button">@Lang.T("Planning ahead", "Planificando")</button>
        </article>
        <article>
            <b>02</b>
            <h3>@Lang.T("Current setup", "Instalación actual")</h3>
            <button type="button" class="on">Tank</button>
            <button type="button">Tankless</button>
            <button type="button">@Lang.T("Not sure", "No estoy seguro")</button>
        </article>
        <article>
            <b>03</b>
            <h3>@Lang.T("Photos speed confirmation", "Las fotos aceleran la confirmación")</h3>
            <label class="upload">+ @Lang.T("Choose equipment photos", "Elegir fotos del equipo")
                <input type="file" accept="image/*,.pdf" multiple />
            </label>
            <p class="builder-note">@Lang.T("Files stay in this browser only. No upload server yet.", "Los archivos quedan solo en este navegador. Aún no hay servidor de carga.")</p>
        </article>
    </div>
</section>
